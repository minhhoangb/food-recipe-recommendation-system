#!/bin/sh
# Enforces "<type>: <description>" (course requirement P4.2). Enable once per clone:
#   git config core.hooksPath .githooks
first_line=$(head -n 1 "$1")
case "$first_line" in
  Merge\ *|Revert\ *) exit 0 ;;
esac
if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|test|refactor|chore|perf|ci|data|exp): .{3,}'; then
  echo "Commit message must look like: <type>: <description>"
  echo "types: feat fix docs test refactor chore perf ci data exp"
  echo "got:   $first_line"
  exit 1
fi
